{
  "name": "@errorgap/nextjs",
  "version": "0.3.0",
  "description": "Next.js SDK for Errorgap error tracking (client and server).",
  "license": "MIT",
  "author": "Errorgap",
  "homepage": "https://github.com/errorgaphq/errorgap-nextjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/errorgaphq/errorgap-nextjs.git"
  },
  "keywords": [
    "errorgap",
    "error-tracking",
    "nextjs",
    "react",
    "monitoring"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@errorgap/browser": "^0.3.0",
    "@errorgap/node": "^0.2.0"
  },
  "peerDependencies": {
    "next": ">=13.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
